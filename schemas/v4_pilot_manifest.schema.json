{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yhappcom/pensionport/blob/main/schemas/v4_pilot_manifest.schema.json",
  "title": "V4 pilot sample manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "roster",
    "quality_targets",
    "pilots"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "roster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "unique_total",
        "long_form",
        "shorts"
      ],
      "properties": {
        "path": {
          "const": "VIDEO_INVENTORY_2026-10-07.md"
        },
        "unique_total": {
          "const": 791
        },
        "long_form": {
          "const": 703
        },
        "shorts": {
          "const": 88
        }
      }
    },
    "quality_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_evidence_coverage",
        "time_sensitive_primary_verification",
        "video_id_match",
        "human_review_for_decision_ready"
      ],
      "properties": {
        "direct_evidence_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "time_sensitive_primary_verification": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "video_id_match": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "human_review_for_decision_ready": {
          "type": "boolean"
        }
      }
    },
    "pilots": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "video_id",
          "title",
          "published_at",
          "category",
          "pilot_scenario",
          "verification_targets",
          "stage",
          "legacy_read",
          "source_acquisition",
          "visual_review"
        ],
        "properties": {
          "video_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "published_at": {
            "oneOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "type": "string",
            "minLength": 2
          },
          "pilot_scenario": {
            "type": "string",
            "minLength": 8
          },
          "verification_targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "stage": {
            "const": "INVENTORIED"
          },
          "legacy_read": {
            "const": "REVIEW_REQUIRED"
          },
          "source_acquisition": {
            "const": "PENDING"
          },
          "visual_review": {
            "const": "NOT_REVIEWED"
          }
        }
      }
    }
  }
}
